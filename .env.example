# Synergy Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# All variables marked REQUIRED must be set for the server to start safely.

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED: MongoDB Atlas connection string. Use a least-privilege user.
MONGO_URI=mongodb+srv://synergy:synergy@synergybase.bkh2z.mongodb.net/?retryWrites=true&w=majority&appName=synergyBase

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED: Cryptographically random string (minimum 32 bytes / 64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=163a1cca35adf0a0357af1f2f49ace08294eed0f2c80263b18b54dccf92c9aaca3a52babb695fd057f8fb9ac51fc93c69b483810fcf28696084e83c3ade42753

# ── Google OAuth ───────────────────────────────────────────────────────────────
# OPTIONAL: Google OAuth Web Client ID. Required only if Google Sign-In is enabled.
GOOGLE_WEB_CLIENT_ID=288663101499-d6gp4q8k5vmt7u8fuo6jqtb7v512772g.apps.googleusercontent.com

# ── AI Provider (Groq) ────────────────────────────────────────────────────────
# OPTIONAL: Groq API key for natural-language reminder parsing and AI summaries.
# If absent, AI features are disabled; manual entry always works.
GROQ_API_KEY=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

# ── Email caregiver alerts ────────────────────────────────────────────────────
# Required only when email is selected by the patient.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_6Md2ZQu4_DidQ7BTt7bwJ16p3fXzU6zWS
EMAIL_FROM=Synergy Alerts <onboarding@resend.dev>

# ── SMS caregiver alerts ──────────────────────────────────────────────────────
# Required only when SMS is selected by the patient.
TWILIO_ACCOUNT_SID=ACeb65bdb31731cd6775b7dff4d026d902
TWILIO_AUTH_TOKEN=0a4c9412716f8ffc2505d303e398675f
TWILIO_FROM_NUMBER=+17372508034

# Rate-limit counters and alert jobs are stored in MongoDB (no Redis required).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# Public-facing base URL of the API (used for opt-out links in caregiver alerts).
# Set to your Render service URL in production, e.g. https://synergy-api.onrender.com
APP_BASE_URL=https://synergy-backend-sf43.onrender.com

# Allowed frontend origin (comma-separated origins; never use * in production).
CORS_ORIGIN=http://localhost:8081
