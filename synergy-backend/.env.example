# Synergy Backend environment template. Replace placeholders locally or in Render.
# Never commit real credentials; keep production values in the hosting provider's secret store.
MONGO_URI=your-private-mongodb-connection-string
JWT_SECRET=replace-with-a-new-random-secret
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GROQ_API_KEY=replace-with-groq-api-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM=Synergy Alerts <alerts@example.com>
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000
PORT=5001
NODE_ENV=development
APP_BASE_URL=https://your-api-host.example.com
CORS_ORIGIN=http://localhost:8081
